{
  "JwtSettings": {
    "Issuer": "QuizNova.Api",
    "Audiences": ["QuizNova.Client"],
    "Secret": "CHANGE_ME_32_CHAR_MIN_SECRET_KEY_PLEASE",
    "ExpiryMinutes": 7,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "QuizNova.Api"
    }
  },
  "CorsSettings": {
    "PolicyName": "QuizNovaCorsPolicy",
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "PostgresSettings": {
    "DefaultConnection": "Host=localhost;Database=quiznova_dev;Username=postgres;Password=postgres",
    "MaximumPoolSize": 100,
    "MinimumPoolSize": 0,
    "ConnectionTimeoutSeconds": 15
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://admin:password@localhost:27017",
    "DatabaseName": "quiznova-mongodb-dev",
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 0,
    "MaxConnecting": 2,
    "WaitQueueTimeoutMinutes": 2
  },
  "RateLimiterSettings": {
    "DisableRateLimiting": false,
    "GlobalConcurrencyPermitLimit": 50,
    "GlobalConcurrencyQueueLimit": 100,
    "SubmitQuizTokenLimit": 200,
    "SubmitQuizTokensPerPeriod": 50,
    "SubmitQuizReplenishmentPeriodSeconds": 1,
    "SubmitQuizQueueLimit": 1000,
    "AuthWindowMinutes": 1,
    "AuthPermitLimit": 5,
    "AuthSegmentsPerWindow": 6
  },
  "CacheSettings": {
    "OutputCacheDurationSeconds": 30,
    "QueryCacheDurationMinutes": 5,
    "DistributedCacheSchemaName": "public",
    "DistributedCacheTableName": "Cache"
  },
  "IdentitySettings": {
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireNonAlphanumeric": true,
    "RequireUppercase": true,
    "RequiredLength": 8,
    "RequireUniqueEmail": true
  },
  "AllowedHosts": "*"
}
